{
	"name": "Jooling",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"@types/bun": "^1.3.14",
			"lucide-react": "^1.27.0",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.7",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"test:integration": "./scripts/test-integration.sh",
		"dev:native": "turbo run dev -F native --",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @SchedulesManager/db --",
		"db:studio": "turbo run db:studio -F @SchedulesManager/db --",
		"db:generate": "turbo run db:generate -F @SchedulesManager/db --",
		"db:migrate": "turbo run db:migrate -F @SchedulesManager/db --",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@SchedulesManager/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@SchedulesManager/config": "workspace:*",
		"@biomejs/biome": "^2.5.6",
		"@types/bun": "catalog:",
		"turbo": "^2.10.7",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.11"
}
