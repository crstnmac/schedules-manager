{
	"name": "Jooling",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"@types/bun": "^1.3.14",
			"lucide-react": "^1.27.0",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.7",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"verify": "bun run check && bun run check-types && bun test && bun run test:integration && bun run build",
		"test:integration": "./scripts/test-integration.sh",
		"dev:native": "turbo run dev -F native --",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"dev:landing": "turbo run dev -F jooling-landing --",
		"dev:knowledge-base": "turbo run dev -F knowledge-base --",
		"db:push": "turbo run db:push -F @SchedulesManager/db --",
		"db:studio": "turbo run db:studio -F @SchedulesManager/db --",
		"db:generate": "turbo run db:generate -F @SchedulesManager/db --",
		"db:migrate": "bun --cwd packages/db db:migrate:deploy",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"lint": "oxlint . --max-warnings 0",
		"reviews:refresh": "bun scripts/gplay-reviews.ts"
	},
	"dependencies": {
		"@SchedulesManager/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@SchedulesManager/config": "workspace:*",
		"@biomejs/biome": "^2.5.6",
		"@shadcn/lint": "^0.1.0",
		"@types/bun": "catalog:",
		"google-play-scraper": "^10.0.0",
		"oxlint": "^1.83.0",
		"turbo": "^2.10.7",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.11",
	"patchedDependencies": {
		"@better-auth/oauth-provider@1.7.5": "patches/@better-auth%2Foauth-provider@1.7.5.patch"
	}
}
