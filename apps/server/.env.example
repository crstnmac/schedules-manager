CORS_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/schedules_manager
DATABASE_POOL_MAX=5
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3001
# Polar organization access token. Use sandbox mode and a sandbox token locally.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_MODE=production
# Optional overrides, primarily for an equivalent sandbox catalog.
POLAR_SCHEDULE_MONTHLY_PRODUCT_ID=
POLAR_SCHEDULE_ANNUAL_PRODUCT_ID=
POLAR_OPERATIONS_MONTHLY_PRODUCT_ID=
POLAR_OPERATIONS_ANNUAL_PRODUCT_ID=
# ZeptoMail > Mail Agents > your agent > API > Send Mail Token.
# Full Authorization header value, matching the previous SDK configuration.
ZEPTOMAIL_TOKEN="Zoho-enczapikey your_send_mail_token"
# This address/domain must be verified in ZeptoMail.
ZEPTOMAIL_FROM_ADDRESS=schedules@example.com
ZEPTOMAIL_FROM_NAME=Schedules Manager
# Change this for your ZeptoMail data center when applicable.
ZEPTOMAIL_API_URL=api.zeptomail.com/
# Match the Agent webhook Authentication Key; required to accept signed provider events.
# Configure https://YOUR_API/v1/webhooks/zeptomail for delivered and bounce events.
ZEPTOMAIL_WEBHOOK_SECRET=
