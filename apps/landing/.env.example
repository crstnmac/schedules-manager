# Landing site (apps/landing). Copy to .env and fill in before deploying.
# Vite only exposes variables prefixed with VITE_.

# Where the app lives and where the docs live.
VITE_APP_URL=http://localhost:3001
VITE_DOCS_URL=https://docs.jooling.com

# ---------------------------------------------------------------------------
# Legal identity. Printed on the Terms, Privacy Policy, DPA, and every site
# footer. Leave a value unset and the wording that would name it is omitted,
# so the documents stay grammatical — nothing shows a placeholder.
#
# Fill these in before the public launch. A Terms page that names no
# counterparty and states no governing law is materially weaker than one that
# visibly says it is missing.
# ---------------------------------------------------------------------------
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_JURISDICTION=
VITE_LEGAL_REGISTRATION_NUMBER=
# Governing law for the Terms, e.g. "the laws of the State of Delaware, USA".
# Unset, Terms §13 simply does not state a governing law.
VITE_LEGAL_GOVERNING_LAW=
# Exclusive venue for disputes, e.g. "the state and federal courts located in
# New Castle County, Delaware, USA".
VITE_LEGAL_VENUE=
VITE_LEGAL_CONTACT_EMAIL=legal@jooling.com
VITE_LEGAL_PRIVACY_EMAIL=privacy@jooling.com
VITE_LEGAL_SUPPORT_EMAIL=support@jooling.com

# ---------------------------------------------------------------------------
# Legal document revision. VITE_TERMS_VERSION is stamped into each consent
# record; set the SAME value here, in apps/web (VITE_TERMS_VERSION), and in the
# server (TERMS_VERSION) whenever the Terms change.
# VITE_TERMS_UPDATED_AT is the ISO date shown as "Last updated".
# ---------------------------------------------------------------------------
VITE_TERMS_VERSION=2026-09-17
VITE_TERMS_UPDATED_AT=2026-09-17

# Analytics. Left unset, no analytics library is initialised at all.
# Non-essential cookies still require the visitor's consent in the banner.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
