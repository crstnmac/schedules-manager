{
	"expo": {
		"name": "jooling",
		"slug": "jooling",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "jooling",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.jooling.SchedulesManager"
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#111B28",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "com.jooling.schedulesmanager"
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-notifications",
				{
					"defaultChannel": "default"
				}
			],
			"./plugins/with-firebase",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#F3F8FD",
					"dark": {
						"backgroundColor": "#111B28"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "4821441f-5fbd-4965-ad36-a5476ffec123"
			}
		},
		"owner": "crstnmac"
	}
}
